# Copy this file to .env. It has two parts: PART 1 for the chat model, PART 2 for the embedding model.
# In EACH part, remove the # in front of ONE block, and put your key after API_KEY= or EMBEDDING_API_KEY=.
# .env holds your keys: never share it or upload it. .env.example can be shared.
# The chat model must support tool calling (the "tools" parameter).

# ============================================================
# PART 1. Chat model (語言模型): writes the answers
# ============================================================

## NKUST
LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
MODEL_NAME=Furen-large
API_KEY=

## Gemini
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-3.5-flash-lite
# API_KEY=

# ============================================================
# PART 2. Embedding model (嵌入模型): turns text into numbers for the house rules search (RAG)
# ============================================================

## NKUST (the embedding model name starts with a capital E).
## Same server as the NKUST chat model, so EMBEDDING_API_KEY may stay empty: the app then reuses API_KEY.
EMBEDDING_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
EMBEDDING_MODEL_NAME=Embedding
EMBEDDING_API_KEY=

## Gemini (free key at https://aistudio.google.com/apikey)
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_API_KEY=

# Optional: the lowest cosine score that counts as a match. The default 0.50 was chosen for the NKUST
# Embedding model. If you change the embedding model, run python check_rag.py and set it here.
# RAG_MIN_SCORE=0.50
